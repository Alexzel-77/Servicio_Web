<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.servicio_web.Controller.UsuariosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Consulta de usuarios - API REST">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <!-- Evento onAction enlazado al método onConsultarClick del controlador -->
        <Button mnemonicParsing="false" onAction="#onConsultarClick" text="Consultar usuarios" />
        <Label text="Presione Consultar usuarios" />
    </HBox>

    <!-- TableView y Columnas con sus respectivos fx:id -->
    <TableView fx:id="tvUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colUsername" prefWidth="100.0" text="Username" />
            <TableColumn fx:id="colCorreo" prefWidth="150.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
            <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
            <TableColumn fx:id="colEmpresa" prefWidth="120.0" text="Empresa" />
        </columns>
    </TableView>
</VBox>